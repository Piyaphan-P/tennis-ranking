# ADGE Tennis (SIT) — ranking site environment template
# Copy to `.env.local` and fill in. NEVER commit real values — .env.local is gitignored.

# --- Backend (server/) ONLY — never exposed to the browser ---
# Postgres connection string for the SHARED Supabase database used by the main
# coaching app. Read rankings from leaderboard_records; backfill from sessions/shots.
#
# IMPORTANT (hard-won): use the IPv4 pooler host, not the direct db.*.supabase.co
# host (which is IPv6-only). Password must be URL-encoded.
#   postgresql://USER:PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# On Cloud Run this is passed via --update-env-vars (Secret Manager unavailable
# for the deploy SA). Locally, put the real value in .env.local ONLY.
DATABASE_URL=

# Postgres schema for environment isolation on the SHARED Supabase database.
# Default 'public' = production behavior, unchanged. SIT sets this to 'sit' so
# SIT reads/writes its own schema (sit.sessions / sit.shots / sit.leaderboard_records)
# without colliding with production. Value must match /^[a-z_][a-z0-9_]*$/ or it
# falls back to 'public'. Isolation is enforced via per-connection search_path.
# DB_SCHEMA=public   # ตั้งเป็น sit สำหรับ SIT environment

# --- DB backend selection (DB_BACKEND) ---
# Which data layer the API + backfill use. Default 'postgres' = today's behavior,
# byte-identical (uses DATABASE_URL + DB_SCHEMA above). 'firestore' = the new
# Google Cloud Firestore path (uses the three vars below; DATABASE_URL ignored).
# DB_BACKEND=postgres

# --- Firestore backend (only when DB_BACKEND=firestore) ---
# Native-mode Firestore database id. SIT uses the pre-provisioned 'nonprd' db.
# FIRESTORE_DATABASE=nonprd
# GCP project that owns the Firestore db.
# GOOGLE_CLOUD_PROJECT=ton-team
# Credentials: Application Default Credentials. On Cloud Run this is the runtime
# SA (roles/datastore.user) via the metadata server — set NOTHING. Locally, point
# GOOGLE_APPLICATION_CREDENTIALS at an SA key file (gitignored, never committed):
#   GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/sa-key.json
# TTL note: `sessions`/`shots` carry `expireAt`, auto-purged by Firestore platform
# TTL (configured on the DB, not in code). This service NEVER deletes them.
# leaderboard_records has no expireAt → durable forever.

# Optional: HTTP port (defaults to 8080).
# PORT=8080
